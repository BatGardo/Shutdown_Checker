# Shutdown_Checker settings. Copy to .env and fill in.
# .env is secret: it is in .gitignore and .dockerignore and never goes to GitHub.
# On Render upload it as a Secret File named .env (service > Environment > Secret Files).

# Telegram bot token from @BotFather.
# Use a separate bot for Render, not the one you test locally: two copies of one bot fight over updates.
TELEGRAM_TOKEN=

# Schedule region: kyiv, kyiv-region, dnipro, odesa. Emergency alerts exist only for kyiv.
REGION=kyiv

# Where the bot keeps subscribers, groups and options. Render's free plan has no disk, so the
# state is stored as a pinned file in a private Telegram channel where the bot is an admin.
# Channel id looks like -1001234567890. Empty = local file bot_state.json (only for a PC).
STATE_CHAT_ID=

# Channels for people (optional, any number: CHANNEL_1_*, CHANNEL_2_*, ...). In each the bot posts one
# status message (refreshed in place), schedule changes, reminders, emergency start/end.
# People only read, so the settings live here. The bot must be an admin of each channel with
# "Post messages" and "Delete messages of others".
# To show an inverter and its Grid Off/On alerts in a channel, set DEYE_n_OWNER_CHAT to that CHANNEL_n_ID.
# Minutes: TRACKER = status refresh (0 = off), REMIND = before an outage, REMIND_ON = before power returns.
# CHANNEL_1_ID=
# CHANNEL_1_GROUP=33.1
# CHANNEL_1_TRACKER=10
# CHANNEL_1_REMIND=15
# CHANNEL_1_REMIND_ON=15
#
# CHANNEL_2_ID=
# CHANNEL_2_GROUP=
# CHANNEL_2_TRACKER=10
# CHANNEL_2_REMIND=15
# CHANNEL_2_REMIND_ON=15

# Public URL of the service. Render sets RENDER_EXTERNAL_URL itself, so leave this empty there.
# PUBLIC_URL=

# Inverters (read-only: grid on/off and battery). "Deye token.bat" fills these blocks.
# Only a time-limited access token is stored here, never the Deye password or AppSecret.
# OWNER_CHAT: the chat that gets this inverter's alerts (send /myid to the bot to see it).
# DEYE_1_NAME=Home
# DEYE_1_TOKEN=
# DEYE_1_DEVICE_SN=
# DEYE_1_OWNER_CHAT=
# DEYE_1_TOKEN_EXPIRES=
# DEYE_1_BASE_URL=https://eu1-developer.deyecloud.com/v1.0
#
# DEYE_2_NAME=Second
# DEYE_2_TOKEN=
# DEYE_2_DEVICE_SN=
# DEYE_2_OWNER_CHAT=
# DEYE_2_TOKEN_EXPIRES=
# DEYE_2_BASE_URL=https://eu1-developer.deyecloud.com/v1.0
#
# Optional, only if the auto-detected data keys are wrong (see "All keys" in Deye token.bat):
# DEYE_1_VOLTAGE_KEY=
# DEYE_1_SOC_KEY=
